<aiml version="1.0">

<!-- This category works with the CN AIML Set -->
<category> <!-- Category是一个自动的AIML单元 -->

    <pattern>LOAD AIML CN</pattern>  <!-- Pattern用来匹配用户输入，如果用户输入 "LOAD AIML CN"-->

    <template><!-- Template是模式的响应,这里学习多个aiml文件 -->
        <!-- 你可以在这里添加更多的aiml文件,*是通配符 -->

        <!-- Load chinese AIML set -->
        <!-- <learn>cn-profile.aiml</learn> -->
        <learn>chinese/cn-*.aiml</learn>
         <!--<learn>chinese/*.xml</learn>-->
        <learn>english/default.aiml</learn>
         <!--<learn>english/*.aiml</learn>-->

    </template>

</category>

</aiml>
